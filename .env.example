# Contact form: sends mail through Resend. See docs/contact-form-resend-setup.md.
# These are read on the server only. Never give them a VITE_ prefix, which would publish them to every visitor.
# Copy this file to .env.local for local development. In production, add them in Vercel under Project > Settings > Environment Variables.

# Created in the Resend dashboard under API Keys. Use a key with the "Sending access" permission.
RESEND_API_KEY=

# The address messages are sent from. It must be on a domain you have verified in Resend, for example noreply@techne.ph.
# For a first test you can use onboarding@resend.dev, but Resend then only delivers to the email address of your own Resend account.
RESEND_FROM=noreply@techne.ph

# Where contact form messages are delivered. Separate several addresses with commas.
CONTACT_TO=info@techne.ph
